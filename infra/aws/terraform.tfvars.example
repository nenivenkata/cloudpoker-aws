region = "us-east-1"
name = "cloudpoker-lab"
admin_cidrs = ["203.0.113.10/32"] # REPLACE with YOUR current public IPv4 /32
kubernetes_version = "1.35"
github_repository = "YOUR_GITHUB_USERNAME/cloudpoker-aws"
node_instance_type = "t3.large"
node_count = 1
# If an account-wide GitHub OIDC provider already exists, supply its real ARN:
# github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
